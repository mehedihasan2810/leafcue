{
  "expo": {
    "scheme": "leafcue",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "LeafCue",
    "slug": "leafcue",
    "plugins": [
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"]
            }
          }
        }
      ],
      "./plugins/with-watermelondb"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.galaxywayai.leafcue"
    },
    "android": {
      "package": "com.galaxywayai.leafcue"
    }
  }
}
