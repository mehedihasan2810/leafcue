{
  "expo": {
    "version": "1.0.1",
    "icon": "./assets/images/icon.png",
    "scheme": "leafcue",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "LeafCue",
    "slug": "leafcue",
    "plugins": [
      "expo-font",
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#e9f9f6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LeafCue needs access to your camera so you can capture photos of your plants. Photos stay on this device.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "LeafCue needs access to your photo library so you can attach photos to your plants. Photos stay on this device.",
          "cameraPermission": "LeafCue needs access to your camera so you can capture photos of your plants. Photos stay on this device."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1f9d55"
        }
      ],
      "expo-image",
      "expo-router",
      "expo-sharing",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.galaxywayai.leafcue",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.galaxywayai.leafcue",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-adaptive-icon.png",
        "backgroundColor": "#e9f9f6"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ],
      "blockedPermissions": ["android.permission.RECORD_AUDIO"]
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ef54e35d-e30e-40b2-8c34-79b18342d077"
      }
    },
    "owner": "galaxyway-ai"
  }
}
