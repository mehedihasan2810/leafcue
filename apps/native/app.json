{
  "expo": {
    "scheme": "leafcue",
    "userInterfaceStyle": "automatic",
    "orientation": "default",
    "web": {
      "bundler": "metro"
    },
    "name": "LeafCue",
    "slug": "leafcue",
    "plugins": ["expo-font", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.galaxywayai.leafcue"
    },
    "android": {
      "package": "com.galaxywayai.leafcue"
    }
  }
}
