# RevenueCat public SDK keys for LeafCue Plus billing.
#
# Billing is OPTIONAL. If none of these are set, LeafCue disables billing
# gracefully: the app still boots, works offline, and all free features work.
# Only creating/reactivating an active plant beyond the free limit is gated.
#
# Use ONLY public SDK keys here (they are safe to ship in the client).
# Never commit a real key — set real values in an uncommitted .env.local.

# Single fallback key, used for both platforms when a platform-specific key is
# not set. Handy for local Test Store testing.
EXPO_PUBLIC_REVENUECAT_API_KEY=

# Production: prefer platform-specific public keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
